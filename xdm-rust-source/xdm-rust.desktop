[Desktop Entry]
Name=XDM-Rust Download Manager
Comment=High-Performance Multi-threaded Download Manager for Windows and Linux
Exec=xdm-rust %U
Icon=xdm-rust
Terminal=false
Type=Application
Categories=Network;FileTransfer;
MimeType=x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=xdm-rust
